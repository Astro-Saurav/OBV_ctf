<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cipher Nest — Operator Panel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#080510;--surface:#0e0a1a;--card:#120d22;--border:#2a1a4a;--purple:#b41eff;--purple-glow:rgba(180,30,255,.12);--amber:#ffb700;--amber-glow:rgba(255,183,0,.12);--red:#ff3333;--green:#00ff41;--text:#d8c8f0;--text-dim:#5a4a7a;--font:'Share Tech Mono','Courier New',monospace}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px;line-height:1.6;min-height:100vh}
    .scanlines{position:fixed;top:0;left:0;width:100%;height:100%;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(180,30,255,.012) 2px,rgba(180,30,255,.012) 4px);pointer-events:none;z-index:9999}
    .topbar{display:flex;justify-content:space-between;align-items:center;padding:8px 24px;background:var(--surface);border-bottom:1px solid var(--border);font-size:12px}
    .topbar-left{color:var(--purple)}
    .topbar-right{color:var(--text-dim)}
    .container{max-width:860px;margin:48px auto 80px;padding:0 20px}
    .card{background:var(--card);border:1px solid var(--border);margin-bottom:16px}
    .card-header{display:flex;align-items:center;gap:6px;padding:11px 18px;border-bottom:1px solid var(--border);font-size:12px;letter-spacing:2px;text-transform:uppercase}
    .purple-hdr{background:rgba(180,30,255,.04);color:var(--purple)}
    .amber-hdr{background:rgba(255,183,0,.04);color:var(--amber);border-color:rgba(255,183,0,.2)!important}
    .card-header .title{flex:1;padding:0 8px}
    .card-body{padding:24px}
    .info-row{display:flex;gap:12px;margin:8px 0;font-size:13px}
    .info-row .lbl{color:var(--text-dim);min-width:120px}
    .info-row .val{color:var(--text)}
    .divider{color:rgba(255,255,255,.06);margin:18px 0;letter-spacing:4px;font-size:11px}
    .locked-msg{padding:20px;background:rgba(255,51,51,.04);border:1px dashed rgba(255,51,51,.3);color:var(--red);text-align:center;font-size:13px;letter-spacing:1px;margin-top:8px}
    .flag-block{padding:20px;background:rgba(0,0,0,.4);border-left:3px solid var(--amber);margin-top:8px}
    .flag-label{color:var(--text-dim);font-size:12px;margin-bottom:10px;letter-spacing:1px}
    .flag-value{color:var(--amber);font-size:15px;word-break:break-all;letter-spacing:1px}
    .role-badge{display:inline-block;padding:3px 10px;font-size:12px;letter-spacing:2px;border-radius:2px;text-transform:uppercase}
    .role-recruit{border:1px solid var(--purple);color:var(--purple)}
    .role-operator{border:1px solid var(--amber);color:var(--amber);background:rgba(255,183,0,.06)}
    .token-display{padding:14px;background:rgba(0,0,0,.5);border:1px solid var(--border);word-break:break-all;font-size:11px;color:var(--text-dim);margin-top:12px;letter-spacing:.5px}
    .token-display span{color:var(--purple)}
    a.btn{display:inline-block;margin-top:20px;padding:11px 28px;background:transparent;border:1px solid var(--text-dim);color:var(--text-dim);text-decoration:none;font-family:var(--font);font-size:13px;letter-spacing:1px;text-transform:uppercase;transition:all .18s}
    a.btn:hover{border-color:var(--purple);color:var(--purple)}
    .bottombar{position:fixed;bottom:0;left:0;width:100%;display:flex;justify-content:space-between;padding:6px 24px;background:var(--surface);border-top:1px solid var(--border);font-size:11px;color:var(--text-dim)}
    @keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
    .blink{animation:blink 1s step-end infinite}
    @keyframes blink-slow{0%,100%{opacity:.8}50%{opacity:.15}}
    .blink-slow{animation:blink-slow 2s ease-in-out infinite}
    .online{color:var(--green)}
  </style>
</head>
